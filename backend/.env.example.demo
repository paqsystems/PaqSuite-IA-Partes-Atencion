APP_NAME="PaqSuite IA Partes Atención"
APP_ENV=production
APP_KEY=base64:**************************
APP_DEBUG=false
APP_URL="https://backenddevpartesatencionpaqsystems.on-forge.com"

# Front develop: demo.partesatencion.paqsystems.com debe quedarse en ese host
# (dominio custom Vercel) o el 302 tiene que llevar ?cliente=DEMO.
# Prod: paq.partesatencion.paqsystems.com → ?cliente=PAQ o hostname paq.
# Local npm run dev: el SDK fuerza DEMO (URL no canónica).

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── PAQSUITE FRAMEWORK (MONO + multidominio) ────────────────────────────────
# tenancy=single: una empresa por instalación. El eje que cambia por URL
# es X-Paq-Cliente (instalación / BD), no X-Company-Id.
PAQSUITE_INSTALLATION_MODE=MONO
PAQSUITE_PROYECTO=partesatencion
PAQSUITE_TENANCY=single
PAQSUITE_DB=unified
PAQSUITE_INSTALACION_RESOLVER=sql
PAQSUITE_INSTALACION_CACHE_TTL=60
PAQSUITE_CENTRAL_CONNECTION=paqsuite_central
PAQSUITE_HEADER_CLIENTE=X-Paq-Cliente
PAQSUITE_HEADER_COMPANY=X-Company-Id
PAQSUITE_DB_DRIVER_REFERENCE=sqlsrv
PAQSUITE_CHAT_LLM_TIMEOUT_SECONDS=60

# ─── Bootstrap SQL (artisan / fallback si una fila no trae host) ─────────────
# Develop: BD DEMO. Prod (otro sitio Forge): BD PAQ u otra; el request
# pisa esta conexión con EMPRESAS_CONEXION (Opción B).
DB_CONNECTION=sqlsrv
DB_HOST=database-1.cf2tcvmvcot6.us-east-2.rds.amazonaws.com
DB_PORT=1433
DB_DATABASE=paqsystems_partesatencion_demo
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true
DB_ENCRYPT=yes

# ─── Catálogo PAQSYSTEMS (obligatorio con resolver=sql) ──────────────────────
# Completar usuario/clave (mismo RDS que DB_* en este lab).
# Nunca dejar HOST vacío: el login cuelga ~60s → 504.
PAQSUITE_CENTRAL_HOST=database-1.cf2tcvmvcot6.us-east-2.rds.amazonaws.com
PAQSUITE_CENTRAL_PORT=1433
PAQSUITE_CENTRAL_DATABASE=PAQSYSTEMS
PAQSUITE_CENTRAL_USERNAME=
PAQSUITE_CENTRAL_PASSWORD=
PAQSUITE_CENTRAL_ENCRYPT=yes
PAQSUITE_CENTRAL_TRUST_SERVER_CERTIFICATE=true

# ─── CACHE / QUEUE / SESSION ─────────────────────────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
