APP_NAME="PaqSuite IA Partes Atención"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

PAQSUITE_INSTALLATION_MODE=MONO

# Framework unificado (PaqSuite-IA-FRAMEWORK) — MONO canónico
PAQSUITE_PROYECTO=partesatencion
PAQSUITE_TENANCY=single
PAQSUITE_DB=unified
# Lookup instalación: config (mapa PHP / PHPUnit) | sql (PAQSYSTEMS.EMPRESAS_CONEXION)
PAQSUITE_INSTALACION_RESOLVER=sql
PAQSUITE_INSTALACION_CACHE_TTL=60
PAQSUITE_CENTRAL_CONNECTION=paqsuite_central
# PAQSUITE_GRID_LAYOUTS_ENABLED=false  # GEN-11 — Fase 4
PAQSUITE_HEADER_CLIENTE=X-Paq-Cliente
PAQSUITE_HEADER_COMPANY=X-Company-Id
PAQSUITE_DB_DRIVER_REFERENCE=sqlsrv

# Chat Asistente IA (TR-008) — timeout hacia el proveedor LLM (segundos)
PAQSUITE_CHAT_LLM_TIMEOUT_SECONDS=60
# Corpus GEN (manuales Framework, SPEC-001-99).
# Por defecto: resources/manual-usuario-gen dentro de paqsuite/laravel-core (≥1.3.3).
# Override opcional (lab / mirror):
# PAQSUITE_GEN_DOCS_ROOT=
# PAQSUITE_GEN_DOCS_ROOT_FALLBACK=

# --- SQL Server operativa (instalación DEMO) ---
DB_CONNECTION=sqlsrv
DB_HOST=192.168.41.2
DB_PORT=1433
DB_DATABASE=PAQSYSTEMS_PARTESATENCION_DEMO
DB_USERNAME=Axoft
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

# --- Catálogo central PAQSYSTEMS (X-Paq-Cliente → EMPRESAS_CONEXION) ---
PAQSUITE_CENTRAL_HOST=192.168.41.2
PAQSUITE_CENTRAL_PORT=1433
PAQSUITE_CENTRAL_DATABASE=PAQSYSTEMS
PAQSUITE_CENTRAL_USERNAME=Axoft
PAQSUITE_CENTRAL_PASSWORD=
PAQSUITE_CENTRAL_ENCRYPT=yes
PAQSUITE_CENTRAL_TRUST_SERVER_CERTIFICATE=true

# --- SQLite (tests PHPUnit / fallback) ---
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# --- MySQL (alternativa) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: en lab local sin Mailpit usar log (el SMTP a mailpit produce mailEngine.sendFailed)
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
