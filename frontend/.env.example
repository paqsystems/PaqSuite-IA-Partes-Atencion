VITE_APP_VERSION=1.1.0
# Licencia DevExtreme 26.1 (LCP, runtime). Se aplica en src/init-devextreme-license.ts.
# Copiar VITE_DEVEXPRESS_LICENSE_KEY del smoke Framework (comillas; no commitear la clave).
# El JWT eyJ de 25.2 no vale en 26.1. Reiniciar Vite tras cambiar este valor.
# VITE_DEVEXPRESS_LICENSE_KEY=
# Destino del proxy /api en desarrollo local (backend php artisan serve)
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Host ASP.NET DevExpress Reporting (diseñador). Vite proxea /DXXRD|/DXXRDV|/DXXQB.
# Sidecar Framework: http://127.0.0.1:5055 (services/dx-reporting)
VITE_DX_REPORTING_HOST=http://127.0.0.1:5055
# true = el browser llama directo al host (requiere CORS). Default: same-origin + proxy Vite.
# VITE_DX_REPORTING_DIRECT=false
# VITE_DX_REPORTING_GET_DESIGNER_MODEL_ACTION=DXXRD/GetDesignerModel
# VITE_DX_REPORTING_REPORT_URL=partes.consultaDetallada.principal
# Solo builds remotos (Vercel): URL absoluta del BE en Forge.
# No setear en local (dejar vacío) para que Vite proxy use VITE_API_PROXY_TARGET.
# Develop: https://backenddev.partesatencion.paqsystems.com
# Prod:    https://backend.partesatencion.paqsystems.com
# VITE_API_BASE_URL=
# SDK FE: @paqsuite/react-core vía Verdaccio (frontend/.npmrc → srv-pq:4873).
# Build requiere red a http://100.110.69.93:4873 (Tailscale). Ver docs/01-arquitectura/deploy-sdk-package-repos.md.
# Hero login — logo opcional. Título/tagline: i18n (locales es/en/pt/fr/it), no estas vars
# si el producto ofrece selector de idioma (ver docs Framework adopcion-auth-ui.md).
# VITE_AUTH_COMPANY_LOGO_URL=
